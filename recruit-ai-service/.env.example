# recruit-ai-service 环境变量模板（复制为 .env 后填写；.env 不入 git）

# LLM 供应商 API Key（必填）。默认 DeepSeek：https://platform.deepseek.com/
LLM_API_KEY=

# OpenAI 兼容接口地址（DeepSeek 默认；换智谱填 https://open.bigmodel.cn/api/paas/v4）
LLM_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-chat（V3）/ deepseek-reasoner（R1）；智谱为 glm-4-flash 等
LLM_MODEL=deepseek-chat

# LLM 调用超时（秒）
LLM_TIMEOUT_SECONDS=60
