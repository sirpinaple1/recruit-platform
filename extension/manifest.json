{
  "manifest_version": 3,
  "name": "招聘发布助手",
  "version": "0.1.0",
  "description": "渠道发布中台浏览器扩展：拉取待发布草稿、一键填充发布页、回填发布结果",
  "permissions": [
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:6017/*",
    "http://localhost:8430/*",
    "https://www.zhipin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8430/*"
      ],
      "js": [
        "content/message-relay.js",
        "content/bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.zhipin.com/web/geek/job-recommend*",
        "https://www.zhipin.com/web/geek/job/publish*"
      ],
      "js": [
        "content/message-relay.js",
        "content/sentinel.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "招聘发布助手",
    "default_popup": "popup/popup.html"
  }
}
