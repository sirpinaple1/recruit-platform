# ==========================================================
#  recruit-platform .gitignore
#  Java 17 / Spring Boot / Maven  +  Vue / Node
# ==========================================================

# ---------- Java / Maven ----------
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
!.mvn/wrapper/maven-wrapper.jar

# ---------- Spring Boot ----------
application-local.yml
application-local.yaml
application-local.properties
application-dev-local.*
*.local.yml
*.local.yaml

# ---------- Node / Vue ----------
node_modules/
dist/
dist-ssr/
.vite/
.output/
.nuxt/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
.stylelintcache

# ---------- 环境变量与凭据（禁止入库）----------
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key
*.p12
*.jks
*.keystore
*-credentials.json

# ---------- 上传 / 运行时数据 ----------
uploads/
files/
data/
*.db
*.db-shm
*.db-wal
*.sqlite

# ---------- 日志与临时文件 ----------
logs/
*.log
*.tmp
*.temp
*.bak
*.orig
*.rej

# ---------- IDE ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- AI 协作本地记忆 ----------
.workbuddy/
